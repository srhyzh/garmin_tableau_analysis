              <calculation class='tableau' formula='CASE [Title]&#13;&#10;&#13;&#10;WHEN &quot;Zurich Walking&quot; THEN &quot;Zurich&quot;&#13;&#10;WHEN &quot;Zurich Cycling&quot; THEN &quot;Zurich&quot;&#13;&#10;WHEN &quot;Zurich Running&quot; THEN &quot;Zurich&quot;&#13;&#10;WHEN &quot;Zurich - Benchmark Run&quot; THEN &quot;Zurich&quot;&#13;&#10;WHEN &quot;Zurich - Drill Workout&quot; THEN &quot;Zurich&quot;&#13;&#10;&#13;&#10;WHEN &quot;Trun Walking&quot; THEN &quot;Trun&quot;&#13;&#10;WHEN &quot;Trun Cycling&quot; THEN &quot;Trun&quot;&#13;&#10;&#13;&#10;WHEN &quot;Breil/Brigels Walking&quot; THEN &quot;Breil/Brigels&quot;&#13;&#10;WHEN &quot;Disentis/Mustér Walking&quot; THEN &quot;Disentis/Mustér&quot;&#13;&#10;WHEN &quot;Glarus Walking&quot; THEN &quot;Glarus&quot;&#13;&#10;WHEN &quot;Quarten Walking&quot; THEN &quot;Quarten&quot;&#13;&#10;WHEN &quot;Weggis Walking&quot; THEN &quot;Weggis&quot;&#13;&#10;WHEN &quot;Therwil Walking&quot; THEN &quot;Therwil&quot;&#13;&#10;WHEN &quot;Uitikon Walking&quot; THEN &quot;Uitikon&quot;&#13;&#10;WHEN &quot;Erlenbach Cycling&quot; THEN &quot;Erlenbach&quot;&#13;&#10;WHEN &quot;Stallikon Cycling&quot; THEN &quot;Stallikon&quot;&#13;&#10;WHEN &quot;Scharans Walking&quot; THEN &quot;Scharans&quot;&#13;&#10;WHEN &quot;Killwangen Cycling&quot; THEN &quot;Killwangen&quot;&#13;&#10;WHEN &quot;Seegräben Walking&quot; THEN &quot;Seegräben&quot;&#13;&#10;WHEN &quot;Pfäffikon Walking&quot; THEN &quot;Pfäffikon&quot;&#13;&#10;WHEN &quot;Basel Walking&quot; THEN &quot;Basel&quot;&#13;&#10;&#13;&#10;WHEN &quot;Schruns Walking&quot; THEN &quot;Schruns&quot;&#13;&#10;WHEN &quot;Seville Walking&quot; THEN &quot;Seville&quot;&#13;&#10;WHEN &quot;Busan Coastal Walk&quot; THEN &quot;Busan&quot;&#13;&#10;WHEN &quot;Calatafimi Segesta Walking&quot; THEN &quot;Calatafimi-Segesta&quot;&#13;&#10;WHEN &quot;Cinisi Walking&quot; THEN &quot;Cinisi&quot;&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END' />

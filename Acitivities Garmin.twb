      <column caption='Distance Clean' datatype='real' default-format='n#,##0&quot; km&quot;;-#,##0&quot; km&quot;' name='[Calculation_560135250167640068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Distance] = &quot;--&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    FLOAT([Distance])&#13;&#10;END' />
      </column>
      <column caption='Steps Clean' datatype='integer' name='[Calculation_560135250170261511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Steps] = &quot;--&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    INT(REPLACE([Steps], &quot;,&quot;, &quot;&quot;))&#13;&#10;END' />

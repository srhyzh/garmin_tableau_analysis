      </column>
      <column caption='Moving Minutes' datatype='real' name='[Calculation_560135250171346954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [Moving Time]) * 60&#13;&#10;+&#13;&#10;DATEPART(&apos;minute&apos;, [Moving Time])&#13;&#10;+&#13;&#10;DATEPART(&apos;second&apos;, [Moving Time]) / 60.0' />
      </column>
